# Operator reference: docs/usage/configuration.md
# Maintainer-only (GitHub/npm — not for runtime): docs/development/maintainer-config.md

# SQLite database (Prisma). Use file:./prisma/dev.db relative to this package.
DATABASE_URL=file:./prisma/dev.db

# Stage artifacts (JSON files per job/stage)
AEGROS_ARTIFACTS_DIR=data/artifacts

# Bind address for the HTTP server
HOST=0.0.0.0
PORT=3000

# Optional: path to built portal static files (default: bundled next to server dist or monorepo aegros-portal/dist)
AEGROS_PORTAL_DIST=

# Comma-separated origins, or * for reflect (dev only). Production: explicit hosts.
CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173

# Requests per minute per IP (Throttler global default)
RATE_LIMIT_PER_MIN=120

# Require X-API-Key / Bearer for all non-public routes (see npm run create-api-key)
API_KEYS_REQUIRED=false

# When true, POST /v1/jobs must include "ackAuthorized": true
AEGROS_ENFORCE_ACK=false

# Pipeline budgets
AEGROS_MAX_HTTP=40
AEGROS_MAX_SUBDOMAINS=80
AEGROS_WALL_MS=120000

# AI: unset | ollama | openai | gemini
AEGROS_AI_PROVIDER=
AEGROS_OLLAMA_URL=http://127.0.0.1:11434
AEGROS_OLLAMA_MODEL=qwen2.5:3b
AEGROS_OPENAI_MODEL=gpt-4o-mini
AEGROS_GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional Linux scanner image (docker run …)
AEGROS_SCANNER_IMAGE=
