{
  "name": "@spearsystems/aegros-server",
  "version": "0.1.0-beta.0",
  "private": true,
  "description": "Spear Aegros NestJS API and static portal host",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "build": "prisma generate && nest build",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "create-api-key": "node ./scripts/create-api-key.mjs",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true}); require('fs').rmSync('tsconfig.build.tsbuildinfo',{force:true})\"",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.11",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.11",
    "@nestjs/platform-express": "^11.1.11",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "6.19.0",
    "@spearsystems/aegros-core": "file:../aegros-core",
    "@spearsystems/aegros-portal": "file:../aegros-portal",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "prisma": "6.19.0",
    "@nestjs/cli": "^11.0.16",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.11",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
