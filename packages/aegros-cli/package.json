{
  "name": "@spearsystems/aegros-cli",
  "version": "0.1.0-beta.1",
  "private": true,
  "description": "Spear Aegros CLI",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "bin": {
