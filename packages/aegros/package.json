{
  "name": "@spearsystems/aegros",
  "version": "0.1.0-rc.1",
  "description": "Spear Aegros CLI for guided external surface assessments.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "keywords": [
    "spear",
    "aegros",
    "security",
    "attack-surface",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spear-systems/spear-aegros.git"
  },
  "bin": {
    "spear-aegros": "bin/spear-aegros.mjs"
  },
  "files": [
    "bin",
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"import('node:fs').then((fs)=>fs.rmSync('dist',{recursive:true,force:true}))\"",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "commander": "^14.0.2",
    "ink": "^7.0.1",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.5"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.14",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  },
  "publishConfig": {
    "access": "public"
  }
}
